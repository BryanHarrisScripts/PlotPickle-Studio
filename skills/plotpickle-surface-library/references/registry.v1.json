  "outOfScope": [
    "automatic ChatGPT Library folder browsing",
    "native Library PPF writeback",
    "new website",
    "automatic third panel",
    "auto-approval or provider spending"
  ],
  "approvalBoundary": "This registers reusable layout and interaction contracts. It does not approve EDITOR visual styling or certify host rendering, backend writeback or device tests.",
