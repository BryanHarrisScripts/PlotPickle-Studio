{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BryanHarrisScripts/PlotPickle/blob/main/schemas/motion-span.v1.schema.json",
  "title": "PlotPickle Motion Span v1 \u2014 provider-neutral draft sidecar",
  "type": "object",
  "required": [
    "schema",
    "spanId",
    "project",
    "addressRange",
    "positions",
    "positionCount",
    "editorialDurationSeconds",
    "editorialFrameCount",
    "sourcePassageIds",
    "reason",
    "productionIntent",
    "providerPlan",
    "state",
    "review"
  ],
  "properties": {
    "schema": {
      "const": "plotpickle.motion-span.v1"
    },
    "spanId": {
      "type": "string",
      "pattern": "^motion-b[0-9]{2}-m[0-9]{2}-s[0-9]{2}-[0-9]{2}$"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "addressRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actNumber",
        "sequenceNumber",
        "blockNumber",
        "miniBlockNumber",
        "startShotNumber",
        "endShotNumber"
      ],
      "properties": {
        "actNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "sequenceNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "blockNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "miniBlockNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "startShotNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "endShotNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      }
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "shotId",
          "shotNumber",
          "frames",
          "firstFrame",
          "visualApproval",
          "savedMarkerPresent",
          "locked"
        ],
        "properties": {
          "shotId": {
            "type": "string",
            "minLength": 1
          },
          "shotNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "frames": {
            "const": 72
          },
          "firstFrame": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^assets/"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            ]
          },
          "visualApproval": {
            "type": "string"
          },
          "savedMarkerPresent": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          }
        }
      }
    },
    "positionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "editorialDurationSeconds": {
      "enum": [
        3,
        6,
        9,
        12,
        15
      ]
    },
    "editorialFrameCount": {
      "enum": [
        72,
        144,
        216,
        288,
        360
      ]
    },
    "sourcePassageIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 12
    },
    "productionIntent": {
      "type": "object",
      "required": [
        "motion"
      ],
      "properties": {
        "motion": {
          "type": "string",
          "minLength": 12
        },
        "camera": {
          "type": "string"
        },
        "performance": {
          "type": "string"
        }
      }
    },
    "continuityRequirements": {
      "type": "object"
    },
    "providerPlan": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "mode",
        "requestedGenerationSeconds",
        "resolution",
        "trimPolicy"
      ],
      "properties": {
        "provider": {
          "const": "fal"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "first-frame-image-to-video"
        },
        "requestedGenerationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "trimPolicy": {
          "enum": [
            "first-editorial-frames",
            "source-linked-trim-after-validation"
          ]
        },
        "priceQuote": {
          "type": [
            "object",
            "null"
          ]
        },
        "costApproved": {
          "const": false
        },
        "generationSubmitted": {
          "const": false
        }
      }
    },
    "supersedesSpanIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "supersededBy": {
      "type": "string"
    },
    "state": {
      "enum": [
        "PLANNED",
        "PROPOSED",
        "SUPERSEDED"
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "state",
        "savedMarkerPresent",
        "locked"
      ],
      "properties": {
        "state": {
          "const": "unreviewed"
        },
        "savedMarkerPresent": {
          "const": false
        },
        "locked": {
          "const": false
        }
      }
    }
  }
}
