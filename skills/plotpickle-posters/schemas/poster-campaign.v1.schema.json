{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://plotpickle.local/schemas/poster-campaign.v1.schema.json",
  "title":"PlotPickle Poster Campaign Brief v1",
  "type":"object",
  "additionalProperties":false,
  "required":["title"],
  "properties":{
    "title":{"type":"string","minLength":1,"maxLength":200},
    "campaign":{"type":"string","minLength":1,"maxLength":120,"default":"Key Art"},
    "posterType":{"enum":["official","teaser","character","ensemble","scene","world"],"default":"official"},
    "tagline":{"type":"string","maxLength":300},
    "logline":{"type":"string","maxLength":1200},
    "audience":{"type":"string","maxLength":300},
    "genre":{"type":"string","maxLength":160},
    "tone":{"type":"string","maxLength":300},
    "visualDirection":{"type":"string","maxLength":2000},
    "subjects":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1},"maxItems":20},
    "callToAction":{"type":"string","maxLength":400},
    "releaseText":{"type":"string","maxLength":300},
    "credits":{"type":"array","items":{"type":"string"}},
    "source":{"type":"object","additionalProperties":false,"required":["file","sha256","projectId","revision"],"properties":{
      "file":{"type":"string","minLength":1},
      "sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
      "projectId":{"type":"string","minLength":1},
      "revision":{"type":["string","integer"]},
      "passageIds":{"type":"array","items":{"type":"string"}}
    }},
    "referenceAssets":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","role","approval"],"properties":{
      "id":{"type":"string","minLength":1},"role":{"enum":["character","world","shot","concept","other"]},"approval":{"enum":["approved","proposed","unverified"]},"sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"}
    }}},
    "copyApproval":{"enum":["approved","draft"],"default":"draft"}
  }
}
